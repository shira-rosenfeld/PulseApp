<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- SAP .NET Connector 3.1 — DLLs must be placed manually in libs/ (not on public NuGet).
         Download x64 binaries from SAP Support Portal (SAP Note 2573790).
         Requires Microsoft Visual C++ Redistributable (latest x64) on the host. -->
    <Reference Include="sapnco">
      <HintPath>libs\sapnco.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="sapnco_utils">
      <HintPath>libs\sapnco_utils.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
