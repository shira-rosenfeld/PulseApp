<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- SAP .NET Connector 3.1 — place the following files from the NCo zip into libs/:
           sapnco.dll, sapnco_utils.dll  (managed assemblies — referenced below)
           ijwhost.dll, cpc4n.dll        (native DLLs — copied to output, NOT referenced)
           SIGNATURE.SMF                 (SAP integrity signature — NCo won't load without it)
         Download x64 binaries from SAP Support Portal. Requires the Microsoft Visual C++
         Redistributable (latest x64) installed on the host at runtime.
         Microsoft.Win32.Registry.dll and System.Configuration.ConfigurationManager.dll
         are also in libs/ — copied to output below, resolved at runtime via the
         AssemblyResolve handler in Program.cs (no NuGet required). -->

    <!-- Managed assemblies: referenced so the compiler resolves NCo types -->
    <Reference Include="sapnco">
      <HintPath>libs\sapnco.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="sapnco_utils">
      <HintPath>libs\sapnco_utils.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!-- All NCo files must land in the output root alongside the .exe.
         Without <Link>, MSBuild preserves the libs\ subdirectory in the output,
         which breaks Windows DLL search when sapnco_utils.dll looks for cpc4n.dll.
         The two managed assemblies are also listed here as Content so they are
         guaranteed to be copied even when the SDK skips C++/CLI Reference items. -->
    <Content Include="libs\sapnco.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>sapnco.dll</Link>
    </Content>
    <Content Include="libs\sapnco_utils.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>sapnco_utils.dll</Link>
    </Content>
    <Content Include="libs\ijwhost.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ijwhost.dll</Link>
    </Content>
    <Content Include="libs\cpc4n.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>cpc4n.dll</Link>
    </Content>
    <Content Include="libs\SIGNATURE.SMF">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SIGNATURE.SMF</Link>
    </Content>
    <!-- NCo 3.1 references these by strong name from within IJW (C++/CLI) code.
         The runtime's base-directory probing does not fire reliably for IJW-loaded
         assemblies, so Program.cs registers an AssemblyResolve handler that loads
         them from AppContext.BaseDirectory instead. -->
    <Content Include="libs\Microsoft.Win32.Registry.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Microsoft.Win32.Registry.dll</Link>
    </Content>
    <Content Include="libs\System.Configuration.ConfigurationManager.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>System.Configuration.ConfigurationManager.dll</Link>
    </Content>
  </ItemGroup>
</Project>
